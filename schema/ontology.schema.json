{
  "$defs": {
    "AIScenario": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "task": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Task",
          "type": "string"
        },
        "entities": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Entities",
          "type": "array"
        },
        "relationships": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Relationships",
          "type": "array"
        },
        "actions": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Actions",
          "type": "array"
        },
        "rules": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Rules",
          "type": "array"
        },
        "events": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Events",
          "type": "array"
        },
        "inputs": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "outputs": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Outputs",
          "type": "array"
        },
        "success_metrics": {
          "items": {
            "maxLength": 10000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Success Metrics",
          "type": "array"
        },
        "human_oversight": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Human Oversight",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "task",
        "entities",
        "inputs",
        "outputs",
        "success_metrics",
        "human_oversight"
      ],
      "title": "AIScenario",
      "type": "object"
    },
    "Action": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "entity": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Entity",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/Property"
          },
          "maxItems": 100,
          "title": "Parameters",
          "type": "array"
        },
        "requires_rules": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Requires Rules",
          "type": "array"
        },
        "emits": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Emits",
          "type": "array"
        },
        "human_approval": {
          "default": false,
          "title": "Human Approval",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "entity"
      ],
      "title": "Action",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Property"
          },
          "minItems": 1,
          "maxItems": 100,
          "title": "Properties"
        },
        "primary_key": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Primary Key",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "properties",
        "primary_key"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "entity": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Entity",
          "type": "string"
        },
        "payload": {
          "items": {
            "$ref": "#/$defs/Property"
          },
          "maxItems": 100,
          "title": "Payload",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "entity"
      ],
      "title": "Event",
      "type": "object"
    },
    "JsonValue": {},
    "Predicate": {
      "additionalProperties": false,
      "properties": {
        "property": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Property",
          "type": "string"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "not_in",
            "contains",
            "exists",
            "absent"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "property",
        "operator"
      ],
      "title": "Predicate",
      "type": "object"
    },
    "Property": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "datetime",
            "enum",
            "string_list",
            "json"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "nullable": {
          "default": false,
          "title": "Nullable",
          "type": "boolean"
        },
        "enum_values": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Enum Values",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "sensitive": {
          "default": false,
          "title": "Sensitive",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "type"
      ],
      "title": "Property",
      "type": "object"
    },
    "Relationship": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "source": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Target",
          "type": "string"
        },
        "cardinality": {
          "enum": [
            "one_to_one",
            "one_to_many",
            "many_to_one",
            "many_to_many"
          ],
          "title": "Cardinality",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "source",
        "target",
        "cardinality"
      ],
      "title": "Relationship",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "entity": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Entity",
          "type": "string"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        },
        "match": {
          "default": "all",
          "enum": [
            "all",
            "any"
          ],
          "title": "Match",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "entity",
        "conditions",
        "message"
      ],
      "title": "Rule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "version": {
      "default": "0.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    },
    "industry": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Industry",
      "type": "string"
    },
    "description": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Entities",
      "type": "array"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/Relationship"
      },
      "maxItems": 200,
      "title": "Relationships",
      "type": "array"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/Action"
      },
      "maxItems": 100,
      "title": "Actions",
      "type": "array"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "maxItems": 100,
      "title": "Rules",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "maxItems": 100,
      "title": "Events",
      "type": "array"
    },
    "ai_scenarios": {
      "items": {
        "$ref": "#/$defs/AIScenario"
      },
      "maxItems": 100,
      "title": "Ai Scenarios",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "industry",
    "description",
    "entities"
  ],
  "title": "Enterprise AI Ontology DSL 1.0",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structural validation only. Use enterprise-ontology validate for cross-reference and rule type checks."
}
