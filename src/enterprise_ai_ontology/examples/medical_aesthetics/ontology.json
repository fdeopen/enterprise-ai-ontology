  "actions": [
    {
      "id": "ConfirmPlan",
      "label": "确认已审计划",
      "description": "专业人员确认计划与知情记录后，由授权人员登记。",
      "entity": "ServicePlan",
      "parameters": [
        {
          "id": "reason",
          "label": "操作原因",
          "description": "操作原因；示例字段定义",
          "type": "string",
          "required": true,
          "nullable": false,
          "enum_values": [],
          "unit": null,
          "sensitive": false
        }
      ],
      "requires_rules": [
        "PlanReviewed",
        "ConsentRecorded"
      ],
      "emits": [
        "PlanConfirmed"
      ],
      "human_approval": true
    },
    {
      "id": "ConfirmAppointment",
      "label": "确认预约",
      "description": "预约人员确认资源和客户意愿。",
      "entity": "Appointment",
      "parameters": [
        {
          "id": "reason",
          "label": "操作原因",
          "description": "操作原因；示例字段定义",
          "type": "string",
          "required": true,
          "nullable": false,
          "enum_values": [],
          "unit": null,
          "sensitive": false
        }
      ],
      "requires_rules": [
        "AppointmentRequested"
      ],
      "emits": [
        "AppointmentConfirmed"
      ],
      "human_approval": true
    },
    {
      "id": "EscalateFollowUp",
      "label": "转交专业复核",
      "description": "将需要关注的反馈交由专业人员处理。",
      "entity": "FollowUp",
      "parameters": [
        {
          "id": "reason",
          "label": "操作原因",
          "description": "操作原因；示例字段定义",
          "type": "string",
          "required": true,
          "nullable": false,
          "enum_values": [],
          "unit": null,
          "sensitive": false
        }
      ],
      "requires_rules": [
        "ReviewNeeded"
      ],
      "emits": [
        "FollowUpEscalated"
      ],
      "human_approval": true
    }
  ],
  "rules": [
    {
      "id": "PlanReviewed",
      "label": "计划已审核",
      "description": "计划必须先由专业人员审核。",
      "entity": "ServicePlan",
      "conditions": [
        {
          "property": "status",
          "operator": "eq",
          "value": "reviewed"
        }
      ],
      "match": "all",
      "severity": "error",
      "message": "计划必须先由专业人员审核。"
    },
    {
      "id": "ConsentRecorded",
      "label": "知情记录齐全",
      "description": "记录知情确认状态，不以 AI 输出代替告知过程。",
      "entity": "ServicePlan",
      "conditions": [
        {
          "property": "consent_confirmed",
          "operator": "eq",
          "value": true
        }
      ],
      "match": "all",
      "severity": "error",
      "message": "记录知情确认状态，不以 AI 输出代替告知过程。"
    },
    {
      "id": "AppointmentRequested",
      "label": "预约待确认",
      "description": "预约应处于 requested 状态。",
      "entity": "Appointment",
      "conditions": [
        {
          "property": "status",
          "operator": "eq",
          "value": "requested"
        }
      ],
      "match": "all",
      "severity": "error",
      "message": "预约应处于 requested 状态。"
    },
    {
      "id": "ReviewNeeded",
      "label": "需要专业复核",
      "description": "标记需专业复核后转交。",
      "entity": "FollowUp",
      "conditions": [
        {
          "property": "needs_review",
          "operator": "eq",
          "value": true
        }
      ],
      "match": "all",
      "severity": "error",
      "message": "标记需专业复核后转交。"
    }
  ],
