      "label": "客户咨询",
      "description": "客户可有多次咨询。",
      "source": "Client",
      "target": "Consultation",
      "cardinality": "one_to_many"
    },
    {
      "id": "ConsultationPractitioner",
      "label": "复核人员",
      "description": "明确专业复核责任。",
