          "description": "业务对象标识；示例字段定义",
          "type": "string",
          "required": true,
          "nullable": false,
          "enum_values": [],
          "unit": null,
          "sensitive": false
        },
        {
          "id": "occurred_at",
          "label": "发生时间",
          "description": "发生时间；示例字段定义",
          "type": "datetime",
          "required": true,
          "nullable": false,
          "enum_values": [],
          "unit": null,
          "sensitive": false
        },
        {
          "id": "actor_id",
          "label": "操作人标识",
          "description": "操作人标识；示例字段定义",
          "type": "string",
          "required": true,
          "nullable": false,
          "enum_values": [],
          "unit": null,
          "sensitive": false
        }
      ]
    },
    {
      "id": "DocumentReleased",
      "label": "单据已放行",
      "description": "记录单据审核结果。",
      "entity": "TradeDocument",
      "payload": [
        {
          "id": "entity_id",
          "label": "业务对象标识",
          "description": "业务对象标识；示例字段定义",
          "type": "string",
          "required": true,
          "nullable": false,
          "enum_values": [],
          "unit": null,
          "sensitive": false
        },
        {
          "id": "occurred_at",
