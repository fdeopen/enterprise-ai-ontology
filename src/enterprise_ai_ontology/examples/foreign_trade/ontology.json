  ],
  "ai_scenarios": [
    {
      "id": "InquiryCopilot",
      "label": "多语言询盘助手",
      "description": "提取询盘中的规格、数量和交期，生成待审报价草稿。",
      "task": "提取询盘中的规格、数量和交期，生成待审报价草稿。",
      "entities": [
        "Buyer",
        "Inquiry",
        "Quotation"
      ],
      "relationships": [
        "BuyerInquiries",
        "InquiryQuotes"
      ],
      "actions": [
        "SendQuotation"
      ],
      "rules": [
        "QuoteReviewed",
        "PositiveQuote"
      ],
      "events": [
        "QuotationSent"
      ],
      "inputs": [
        "客户邮件",
        "商品目录",
        "已授权价格表"
      ],
      "outputs": [
        "结构化询盘",
        "报价草稿及缺失信息"
      ],
      "success_metrics": [
        "关键字段准确率",
        "币种错误率",
        "人工修订量"
      ],
      "human_oversight": "业务员确认报价，AI 不承诺价格或交期。"
    },
    {
      "id": "DocumentCopilot",
      "label": "单证一致性助手",
      "description": "比对合同、出运计划和单据字段，标记疑点。",
      "task": "比对合同、出运计划和单据字段，标记疑点。",
      "entities": [
        "Contract",
        "Shipment",
        "TradeDocument"
      ],
      "relationships": [
        "ContractShipments",
        "ShipmentDocuments"
      ],
      "actions": [
        "ReleaseDocument"
      ],
      "rules": [
        "DocumentReviewed"
      ],
      "events": [
        "DocumentReleased"
      ],
      "inputs": [
        "合同字段",
        "出运计划",
        "单据文本"
      ],
      "outputs": [
        "不一致清单及出处"
      ],
      "success_metrics": [
        "差异召回率",
        "错误放行建议率"
      ],
      "human_oversight": "单证员和相关专业人员完成最终复核。"
    }
