  "relationships": [
    {
      "id": "BuyerInquiries",
      "label": "客户询盘",
      "description": "客户提交采购需求。",
      "source": "Buyer",
      "target": "Inquiry",
      "cardinality": "one_to_many"
    },
    {
      "id": "InquiryQuotes",
      "label": "询盘报价",
      "description": "多次报价对应同一需求。",
      "source": "Inquiry",
      "target": "Quotation",
      "cardinality": "one_to_many"
    },
    {
      "id": "QuoteContracts",
      "label": "报价转合同",
      "description": "经确认的报价可形成合同。",
      "source": "Quotation",
      "target": "Contract",
      "cardinality": "one_to_many"
    },
    {
      "id": "ContractShipments",
      "label": "合同出运",
      "description": "合同可分批交付。",
      "source": "Contract",
      "target": "Shipment",
      "cardinality": "one_to_many"
    },
    {
      "id": "ShipmentDocuments",
      "label": "出运单据",
      "description": "每次出运关联多类单据。",
      "source": "Shipment",
      "target": "TradeDocument",
      "cardinality": "one_to_many"
    }
  ],
  "actions": [
    {
      "id": "SendQuotation",
      "label": "发送已审报价",
      "description": "业务员复核价格、术语和币种后发送。",
      "entity": "Quotation",
      "parameters": [
        {
          "id": "reason",
          "label": "操作原因",
          "description": "操作原因；示例字段定义",
          "type": "string",
          "required": true,
          "nullable": false,
          "enum_values": [],
          "unit": null,
          "sensitive": false
        }
      ],
      "requires_rules": [
        "QuoteReviewed",
        "PositiveQuote"
      ],
      "emits": [
        "QuotationSent"
      ],
      "human_approval": true
    },
    {
      "id": "BookShipment",
      "label": "申请订舱",
      "description": "履约人员按已签合同申请订舱。",
      "entity": "Contract",
      "parameters": [
        {
          "id": "reason",
          "label": "操作原因",
          "description": "操作原因；示例字段定义",
          "type": "string",
          "required": true,
          "nullable": false,
          "enum_values": [],
          "unit": null,
          "sensitive": false
        }
      ],
      "requires_rules": [
        "ContractSigned"
      ],
      "emits": [
        "BookingRequested"
      ],
      "human_approval": true
    },
    {
      "id": "ReleaseDocument",
      "label": "放行贸易单据",
      "description": "单证员确认事实及一致性后放行。",
      "entity": "TradeDocument",
      "parameters": [
        {
          "id": "reason",
          "label": "操作原因",
          "description": "操作原因；示例字段定义",
          "type": "string",
          "required": true,
          "nullable": false,
          "enum_values": [],
          "unit": null,
          "sensitive": false
        }
      ],
      "requires_rules": [
        "DocumentReviewed"
      ],
      "emits": [
        "DocumentReleased"
      ],
      "human_approval": true
    }
  ],
  "rules": [
    {
      "id": "QuoteReviewed",
      "label": "报价已复核",
      "description": "报价须 reviewed 后方可发送。",
      "entity": "Quotation",
      "conditions": [
        {
          "property": "status",
          "operator": "eq",
          "value": "reviewed"
        }
      ],
      "match": "all",
      "severity": "error",
      "message": "报价须 reviewed 后方可发送。"
    },
    {
      "id": "PositiveQuote",
      "label": "报价金额为正",
      "description": "报价金额必须大于零。",
      "entity": "Quotation",
      "conditions": [
        {
          "property": "amount",
          "operator": "gt",
          "value": 0
        }
      ],
      "match": "all",
      "severity": "error",
      "message": "报价金额必须大于零。"
    },
    {
      "id": "ContractSigned",
      "label": "合同已签署",
      "description": "须确认合同签署状态。",
      "entity": "Contract",
      "conditions": [
        {
          "property": "status",
          "operator": "eq",
          "value": "signed"
        }
      ],
      "match": "all",
      "severity": "error",
      "message": "须确认合同签署状态。"
    },
    {
      "id": "DocumentReviewed",
      "label": "单据人工复核",
      "description": "单据需要人工复核。",
      "entity": "TradeDocument",
      "conditions": [
        {
          "property": "reviewed",
          "operator": "eq",
          "value": true
        }
      ],
      "match": "all",
      "severity": "error",
      "message": "单据需要人工复核。"
    }
  ],
